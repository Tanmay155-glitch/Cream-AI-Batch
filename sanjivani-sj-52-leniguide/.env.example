# ============================================================================
# LeniGuide LLM Configuration (.env.example)
# Student: Tanmay Subhash Gawali (Reg No: 2124UMLM2016, Branch: CSE AI & ML)
# Project: SJ-52 | Product: LeniGuide (Ajanta & Ellora UNESCO Heritage Guide)
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to create your local .env:
#      copy .env.example .env      (Windows CMD / PowerShell)
#      cp .env.example .env        (Linux / macOS)
# 2. Add your Groq API key or Google Gemini API key below.
# 3. CRITICAL SECURITY RULE: NEVER commit .env to Git! It is ignored in .gitignore.
# ============================================================================

# LLM Provider selection: "groq" or "gemini" (fallback: intelligent rule-based offline)
LLM_PROVIDER=groq

# ----------------------------------------------------------------------------
# 1. Groq API Configuration (Fast LLaMA 3.1 Inference)
#    Get your free API key at: https://console.groq.com/keys
# ----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ----------------------------------------------------------------------------
# 2. Google Gemini API Configuration (Alternative Provider)
#    Get your API key at: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ----------------------------------------------------------------------------
# 3. Model Generation Hyperparameters
# ----------------------------------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=15
